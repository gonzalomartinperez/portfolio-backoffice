{
  // Ecosystem markdownlint settings (engineering-standards .markdownlint-cli2.jsonc) plus the HTML
  // elements this README's screenshot gallery uses. Prose lines are not wrapped by rule.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": {
      "allowed_elements": ["div", "img", "h1", "p", "a", "picture", "source", "br", "details", "summary", "table", "tr", "td", "strong"]
    },
    "MD041": false,
    "MD060": false,
    "MD024": { "siblings_only": true }
  },
  // docs/master-plan holds byte-identical shared plan copies and research notes maintained
  // through the standards process.
  "ignores": ["docs/master-plan/**", "node_modules/**", ".next/**", "CODE_OF_CONDUCT.md"]
}
